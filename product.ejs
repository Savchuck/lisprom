<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
	<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link rel="stylesheet" href="../product.css">
  <title>Ліспромсервіс ЛТД</title>
</head>
<body>
<nav class="navbar navbar-expand-lg p-3">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"  tabindex="1">Ліспромсервіс ЛТД</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    
      <div class="collapse navbar-collapse" id="navbarNavDropdown">
        
        <ul class="navbar-nav ms-auto text-center">
          <li class="nav-item">
            <a class="nav-link mx-2 active" aria-current="page" href="/"  tabindex="2">ГОЛОВНА</a>
          </li>
          
          <li class="nav-item dropdown">
            <a class="nav-link mx-2 dropdown-toggle" href="/catalog" id="navbarDropdownMenuLink"  aria-expanded="false"  tabindex="3">
              КАТАЛОГ
            </a>
            <ul class="dropdown-menu" >
              
            </ul>
          </li>
          
        </ul> 

        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link mx-2" href="/login"  tabindex="7" id="login-button">Вхід/Реєстрація
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-in-right" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z"/>
                <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
              </svg>
            </a>
          </li>
        </ul>

      </div>
    </div>
</nav>
<main class="product-block">
  
  <div class="product-block-items-left">
    <img src="../img/catalog/1.jpg" width="500px" height="500px" alt="">
  </div>
  <div class="product-block-items-right">
    <h1>
      <%= product.toUpperCase() %>
    </h1>
    <hr>

    <label for="length">Довжина, мм:</label>
    <select id="length" name="length">
      <option value="default" selected>Виберіть довжину</option>
    </select>
    <br class="br-width"><br>
    <div class="width-block">
    <label for="width">Ширина, мм:</label>
    <select id="width" name="width">
      <option value="default" selected>Виберіть ширину</option>
    </select>
    </div>
    <br class="br-width-bottom"><br>
    <label for="height">Висота, мм:</label>
    <select id="height" name="height">
      <option value="default" selected>Виберіть висоту</option>
    </select>
    <br><br>
    <label for="type">Тип деревини: </label>
    <select id="type" name="type">
      <option value="default" selected>Виберіть тип деревини</option>
      <option value="Дуб">Дуб</option>
      <option value="Ясен">Ясен</option>
      <option value="Сосна">Сосна</option>
      <option value="Береза">Береза</option>
    </select>
    <input type="hidden" id="category" value="<%= product %>">
    <br><br>

    <input type="number" id="quantity" name="quantity" min="1" step="1">
    <button class="order-basket">Додати у кошик</button>
    <br>
    <p class="prices-item">00.00 грн/шт</p>
  </div>
</main>

<footer class="footer-main">
  <div class="footer-catalog-block">
    <h3>Каталог</h3>
    <div class="footer-catalog-items"></div>
  </div>
  <div class="footer-info-block">
    <h3>Інформація</h3>
    <span><a  class="catalog-footer-span" href="/catalog">Каталог</a></span><br>
    <span><a  class="catalog-footer-span" href="/">Про компанію</a></span><br>
    <span><a  class="catalog-footer-span" href="/">Контакти</a></span>
  </div>
  <div class="footer-catalog-block">
    <h3>Контакти</h3>
    <div class="contact-footer">
      <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-telephone" viewBox="0 0 16 16">
        <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
      </svg>
      <h5>Контактний телефон: <br>+380 (67) 382-00-89<br>
        +380 (36) 572-18-75</h5>
    </div>
    <div class="contact-footer">
      <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-buildings" viewBox="0 0 16 16">
        <path d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022M6 8.694 1 10.36V15h5zM7 15h2v-1.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5V15h2V1.309l-7 3.5z"/>
        <path d="M2 11h1v1H2zm2 0h1v1H4zm-2 2h1v1H2zm2 0h1v1H4zm4-4h1v1H8zm2 0h1v1h-1zm-2 2h1v1H8zm2 0h1v1h-1zm2-2h1v1h-1zm0 2h1v1h-1zM8 7h1v1H8zm2 0h1v1h-1zm2 0h1v1h-1zM8 5h1v1H8zm2 0h1v1h-1zm2 0h1v1h-1zm0-2h1v1h-1z"/>
      </svg>
      <h5>Виробництво<br>
        35065, Україна, Рівненський р-н, Рівненська обл.,<br> село Лісопіль, вулиця Грушевського, будинок, 3є</h5>
    </div>
    <div class="contact-footer">
      <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
        <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
      </svg>
      <h5>Email:<br>lispromltd@gmail.com</h5>
    </div>
  </div>
</footer>
<div class="basket">
  <svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" fill="rgb(234, 222, 207)" class="bi bi-cart" viewBox="0 0 16 16">
    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
  </svg>
</div>
<div class="basket-block">
  
  <div class="basket-block-items">
    
  </div>
  <h3 style="position: sticky; bottom: 40px; text-align: center; background-color: rgb(233, 223, 205); height: 40px;">Загальна сума: <span id="price-all">0</span> <span>грн</span></h3>
    <button class="basket-verify" >
      Перейти до оформлення
    </button>
</div>



<div class="toast-container position-fixed bottom-0 end-0 p-3" >
  <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="toast-header">
      <strong class="me-auto">Помилка</strong>
      <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
    <div class="toast-body">
      Ви не вибрали всі параметри!
    </div>
  </div>
</div>
<script src="../product.js"></script>
<script src="../login-check.js"></script>
</body>
</html>
